{
  "name": "cowri-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cowri web client. React frontend for the Cowri Rust API.",
  "scripts": {
    "dev": "next dev --port 5173 --webpack",
    "build": "tsc --noEmit && next build --webpack",
    "preview": "node preview-server.mjs",
    "typecheck": "tsc --noEmit",
    "mock-api": "node mock-api.mjs",
    "smoke": "node smoke.mjs",
    "smoke:app": "node smoke-app.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-plugin": "^1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
