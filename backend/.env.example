# Copy to backend/.env — never commit the real file.

# ── Database (Supabase session pooler or local Postgres) ──────────────────────
# Docker: postgres://cowri:cowri@db:5432/cowri
# Local:  postgres://cowri:cowri@localhost:5432/cowri
# Supabase: postgres://postgres.[ref]:[password]@aws-0-….pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://cowri:cowri@db:5432/cowri

# Railway sets this automatically
# PORT=3000

# Cookie SameSite: Strict (default, Cloudflare gateway same-site) or None (Pages → Railway direct)
# COOKIE_SAMESITE=Strict

# Pepper for BVN HMAC (falls back to JWT_SECRET if unset)
# BVN_HASH_PEPPER=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker: redis://redis:6379
# Local:  redis://localhost:6379
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Production only — the domain Caddy requests a TLS certificate for
# (docker-compose.prod.yml / Caddyfile). Unused locally.
API_DOMAIN=api.cowri.app

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_FROM=Cowri <noreply@cowri.app>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# ── SMS (Termii) ──────────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Cowri

# ── KYC (Prembly BVN Basic) ───────────────────────────────────────────────────
PREMBLY_API_KEY=

# ── Media (Cloudflare R2) ─────────────────────────────────────────────────────
# R2_ACCOUNT_ID / R2_BUCKET_NAME: infra/r2.tf. R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY come from an R2 API token (Cloudflare dashboard → R2 →
# Manage API Tokens), not the CLOUDFLARE_API_TOKEN Terraform uses.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=cowri-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The R2 custom domain (infra/r2.tf) — public base URL for uploaded media.
R2_PUBLIC_URL=https://media.cowri.app

# ── Admin bootstrap (one-time) ────────────────────────────────────────────────
# Generate: openssl rand -hex 16
ADMIN_BOOTSTRAP_SECRET=
